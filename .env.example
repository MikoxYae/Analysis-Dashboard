# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Your MongoDB connection string (required)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# ─── Server ───────────────────────────────────────────────────────────────────
# Port on your VPS to expose the dashboard (default: 3000)
HOST_PORT=3000
